<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DetailLivraison"
             BackgroundColor="#F6F5FA">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="#EDEDED"
               Padding="20,40,20,20"
               CornerRadius="0"
               HasShadow="True"
               Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Image Source="menu.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="Minot'Scan"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#3D2C8D"/>
                <Image Grid.Column="2"
                       Source="user.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1" Padding="0,20,0,0">
            <StackLayout Padding="20" Spacing="18">
                <Label Text="Détails de la livraison"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#3D2C8D"/>

                <!-- Adresse -->
                <Frame BackgroundColor="#FFFFFF"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       Margin="0,10,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Livraison.Commande.Client.Nom}" FontSize="18" TextColor="#222"/>
                        <Label Text="{Binding Livraison.Commande.Client.Prenom, StringFormat='Prénom : {0}'}" FontSize="18" TextColor="#222"/>
                        <Label Text="{Binding Livraison.Commande.Client.Adresse, StringFormat='Adresse : {0}'}" FontSize="18" TextColor="#222"/>
                    </StackLayout>
                </Frame>

                <!-- Date prévue -->
                <Frame BackgroundColor="#FFFFFF"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       Margin="0,10,0,0">
                    <Label Text="{Binding Livraison.DatePrevue, StringFormat='Date prévue : {0:dd/MM/yyyy}'}" FontSize="16" TextColor="#222"/>
                </Frame>

                <!-- Statut -->
                <Frame BackgroundColor="#FFFFFF"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       Margin="0,10,0,0">
                    <Label Text="{Binding Livraison.Statut, StringFormat='Statut : {0}'}" FontSize="16" TextColor="#222"/>
                </Frame>

                <!-- Contenu de la livraison -->
                <Label Text="Contenu de la livraison :" FontSize="20" FontAttributes="Bold" TextColor="#3D2C8D" Margin="0,10,0,0"/>
                <CollectionView ItemsSource="{Binding Livraison.Commande.Produits}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="0,0,0,8" Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Produit.NomProduit}" FontSize="16" FontAttributes="Bold" TextColor="#222"/>
                                <Label Text="{Binding Quantite, StringFormat='x{0}'}" FontSize="16" TextColor="#888"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Remarques -->
                <Label Text="Remarques :" FontSize="16" FontAttributes="Bold" TextColor="#3D2C8D" Margin="0,10,0,0"/>
                <Frame BackgroundColor="#FFFFFF"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       Margin="0,10,0,0">
                    <Label Text="{Binding Livraison.Commentaire}" FontSize="13" TextColor="#222"/>
                </Frame>
            </StackLayout>
        </ScrollView>

        <!-- Boutons d'action -->
        <Grid Grid.Row="2" Padding="20,0,20,20" ColumnDefinitions="*,*,*" VerticalOptions="End">
            <!-- Bouton Itinéraire GPS -->
            <Button Grid.Column="0"
                    Text="Itinéraire GPS"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="24"
                    Margin="0,0,10,0"
                    Clicked="OnItineraireClicked"/>

            <!-- Bouton Remarque -->
            <Button Grid.Column="1"
                    Text="Remarque"
                    BackgroundColor="#7C6AEF"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="24"
                    Margin="10,0,10,0"
                    Clicked="OnRemarqueClicked"/>

            <!-- Bouton Terminer la livraison -->
            <Button Grid.Column="2"
                    Text="Terminer la livraison"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="24"
                    Margin="10,0,0,0"
                    IsVisible="{Binding PeutTerminer}"
                    Clicked="OnLivrerClicked"/>
        </Grid>
    </Grid>
</ContentPage>